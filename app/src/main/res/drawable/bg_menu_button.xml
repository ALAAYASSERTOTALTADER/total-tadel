<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#5A00C8" android:endColor="#8A00FF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#C45CFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#171037" android:endColor="#090A1A"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#6E21A8"/>
        </shape>
    </item>
</selector>
