<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050612"
    android:layoutDirection="rtl">

    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#0E0A22">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="total • LIVE ⚽" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:gravity="center_vertical"/>
        <Button android:id="@+id/fullscreenButton" android:layout_width="54dp" android:layout_height="44dp" android:text="⛶" android:textColor="#FFFFFF" android:textSize="18sp" android:backgroundTint="#7A00FF"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/playerContainer" android:layout_width="match_parent" android:layout_height="230dp" android:background="#000000">
        <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"/>
        <ProgressBar android:id="@+id/loading" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختر قناة لبدء البث" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" android:padding="8dp" android:background="#0D0A1C"/>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:fillViewport="true" android:scrollbars="none" android:background="#110D27">
        <LinearLayout android:id="@+id/controlBar" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
            <Button android:id="@+id/qualityButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="الجودة ⚙" android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#7A00FF"/>
            <Button android:id="@+id/favoriteButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="⭐ مفضلة" android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#7A00FF"/>
            <Button android:id="@+id/lockButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="🔓 قفل" android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#7A00FF"/>
            <Button android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="↻ إعادة الاتصال" android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#7A00FF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="#0B0919">
        <SearchView android:id="@+id/searchChannels" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:queryHint="ابحث عن قناة..." android:iconifiedByDefault="false"/>
        <Button android:id="@+id/refreshButton" android:layout_width="54dp" android:layout_height="44dp" android:text="↻" android:textColor="#FFFFFF" android:textSize="18sp" android:backgroundTint="#7A00FF"/>
    </LinearLayout>

    <TextView android:id="@+id/sectionTitle" android:layout_width="match_parent" android:layout_height="46dp" android:text="📺 القنوات" android:textColor="#D15CFF" android:textStyle="bold" android:textSize="17sp" android:gravity="center_vertical" android:paddingStart="16dp" android:background="#0B0919"/>
    <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#25133F" android:dividerHeight="1dp" android:background="#080918"/>
</LinearLayout>
